.Rproj.user
.Rhistory
.RData
.Ruserdata

# local secrets/credentials - never commit this file
.Renviron

# aquamatch files directory
aquamatch_files/

# hypertune folder
regional_clarity/xg_models/hypertune/

# some file types that we generally don't want to track
**.DS_Store
**.csv
**.feather
**.parquet
**.rds
**.png
**/__pycache__/
/.quarto/
**/*.quarto_ipynb

# ...except Quarto's frozen Rmd results, which the site build needs
!_freeze/**/*.png

# ...and the model folder's tables that users need to apply the model
# (SHAP ranking, per-seed feature table, applicability-check reference)
!regional_clarity/xg_models/v3_production/*.csv
!regional_clarity/xg_models/v3_production/applicability/*.csv
!regional_clarity/xg_models/v3_band_only/*.csv
!regional_clarity/xg_models/v3_band_only/applicability/*.csv

# ...and the holdout-sweep figures from 06 and 06b
!regional_clarity/xg_models/test_set_sensitivity/*.png
!regional_clarity/xg_models/test_set_sensitivity_band_only/*.png

# rendered Quarto site (built and deployed by .github/workflows/publish.yml)
/_site/


# Python virtual environment (see README: Python environment)
/.venv/
